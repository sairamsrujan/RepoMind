# Copy this file to `.env` and fill in your values. `.env` is gitignored.

# Required for GitHub ingestion (a classic or fine-grained PAT with public-repo
# read scope). Without it you are limited to 60 unauthenticated requests/hour.
GITHUB_TOKEN=

# --- Optional: RAGAS judge provider ---------------------------------------- #
# JUDGE_PROVIDER selects the swappable evaluation judge: groq | gemini | ollama
# The default is "groq"; set to "ollama" to run the judge fully locally with
# no third-party API call (only place that may hit a free-tier API).
JUDGE_PROVIDER=ollama

# Only needed if JUDGE_PROVIDER=groq
GROQ_API_KEY=

# Only needed if JUDGE_PROVIDER=gemini
GEMINI_API_KEY=

# --- Optional model overrides (defaults live in config.py) ------------------ #
# EMBEDDING_MODEL=qwen3-embedding:0.6b
# GENERATION_MODEL=qwen2.5:7b-instruct
# OLLAMA_HOST=http://localhost:11434

# --- Optional: cloud generation (better answers/metrics; falls back to local) --
# GENERATION_PROVIDER=api routes answering to a hosted OpenAI-compatible model.
# ANY failure (bad key, rate limit, retired model, no network) automatically
# falls back to local Ollama, so the app never goes down because a provider did.
# GENERATION_PROVIDER=api
# GENERATION_API_KEY=your_key_here
#
# Pick ONE provider's base_url + model:
#   Groq:       https://api.groq.com/openai/v1              llama-3.3-70b-versatile
#   Gemini:     https://generativelanguage.googleapis.com/v1beta/openai/   gemini-2.0-flash
#   NVIDIA NIM: https://integrate.api.nvidia.com/v1         meta/llama-3.3-70b-instruct
#   OpenRouter: https://openrouter.ai/api/v1                (see their model list)
# GENERATION_API_BASE_URL=https://api.groq.com/openai/v1
# GENERATION_API_MODEL=llama-3.3-70b-versatile
# GENERATION_API_FALLBACK=true

# --- Multi-provider LLM roles (all free tiers) -------------------------------
# THREE evaluation roles must be THREE DIFFERENT MODELS:
#
#   1. answerer      = GENERATION_API_MODEL   (writes the answer)
#   2. judge         = JUDGE_*                (grades faithfulness/relevancy)
#   3. question-gen  = QUESTIONGEN_*          (writes the golden questions)
#
# A judge that shares a model with the answerer is grading its own output; one
# that shares with the question author rewards its own phrasing. Both inflate
# the scores. Verify with:  python scripts/check_providers.py
#
# Providers: groq | gemini | nvidia | openrouter | cerebras | ollama
# Any provider with no key silently falls back to the local Ollama model.
#
# --- Provider fallback chains (the reliability mechanism) --------------------
# Each role is an ORDERED, comma-separated list of "provider:model". The first
# entry that answers wins; the LOCAL model is always appended automatically, so
# the app keeps working with no keys and no network.
#
# This exists because free tiers are not durable. Measured in a single session:
# Gemini returned "no longer available" for two models and 429 for the rest,
# Cerebras returned 402 (its free tier is not on every account), and Groq's
# daily token cap was exhausted after a few dozen questions. Any single-provider
# setting WILL break before a demo nine months out.
#
# Model sizing: the free-tier cap is tokens-per-DAY, and input cost is identical
# whatever model reads it. A 550B model burns the daily budget several times
# faster than a 70B one while adding nothing to a grounding-and-formatting task.
# Each role below uses the SMALLEST model that does its job well.
#
# ANSWERER — needs instruction-following (cite every claim, refuse when thin),
#            not scale. Demo-facing, so quality is visible. Llama family.
# GENERATION_CHAIN=groq:llama-3.3-70b-versatile,nvidia:nvidia/llama-3.3-nemotron-super-49b-v1.5
#
# JUDGE — emits two calibrated floats; wants consistency, not creativity, and
#         runs offline so latency is irrelevant. DeepSeek family (never the same
#         family as the answerer it grades). "flash" before "pro" on cost.
# JUDGE_CHAIN=nvidia:deepseek-ai/deepseek-v4-flash,nvidia:deepseek-ai/deepseek-v4-pro,groq:openai/gpt-oss-120b
#
# QUESTION AUTHOR — must infer *why* from scattered evidence, so reasoning helps.
#         nemotron-3-nano is 30B mixture-of-experts with ~3B active: reasoning
#         behaviour at a fraction of the token cost. Nemotron family.
# QUESTIONGEN_CHAIN=nvidia:nvidia/nemotron-3-nano-30b-a3b,openrouter:nvidia/nemotron-nano-9b-v2:free
#
# Single-model overrides (used only when the chains above are unset):
# QUESTIONGEN_PROVIDER=nvidia
# QUESTIONGEN_MODEL=nvidia/nemotron-3-nano-30b-a3b
# JUDGE_PROVIDER=nvidia
# JUDGE_MODEL=deepseek-ai/deepseek-v4-flash
#
# Free-tier keys (all genuinely free, no card required). Measured status:
# NVIDIA_API_KEY=          # build.nvidia.com   BEST free tier: 102 models,
#                          #   Nemotron + DeepSeek. Primary for judge + questiongen.
# GROQ_API_KEY=            # console.groq.com   Fastest, but a small daily token
#                          #   cap — expect fallback during bulk evaluation.
# OPENROUTER_API_KEY=      # openrouter.ai/keys Models tagged ":free" work, but
#                          #   some need "prompt training" enabled in your
#                          #   privacy settings or they 404 with
#                          #   "No endpoints matching your guardrail".
# GEMINI_API_KEY=          # aistudio.google.com  UNRELIABLE — see note below.
# CEREBRAS_API_KEY=        # cloud.cerebras.ai    Returned 402 "Payment required"
#                          #   on all 3 models; its free tier is not on every
#                          #   account. Left in the registry, not used in chains.
#
# Gemini note: newer AI Studio keys use the "AQ." format (the older "AIza"
# format is no longer issued) and DO authenticate correctly. The problem is
# availability, not the key: gemini-2.5-flash / -flash-lite now return 404
# "no longer available", 2.0-flash and 2.5-pro return 429 quota-exceeded, and
# 3.5-flash returns 503. It is therefore kept OUT of the default chains.
#
# Verify all of this yourself at any time:  python scripts/check_providers.py
#
# Per-provider judge model overrides (used when JUDGE_MODEL is unset):
# JUDGE_MODEL_GROQ=openai/gpt-oss-120b
# JUDGE_MODEL_NVIDIA=deepseek-ai/deepseek-v4-pro
# JUDGE_MODEL_OPENROUTER=meta-llama/llama-3.3-70b-instruct:free
# JUDGE_MODEL_OLLAMA=qwen2.5:7b-instruct
