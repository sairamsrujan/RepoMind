# Copy this file to `.env` and fill in your values. `.env` is gitignored.

# Required for GitHub ingestion (a classic or fine-grained PAT with public-repo
# read scope). Without it you are limited to 60 unauthenticated requests/hour.
GITHUB_TOKEN=

# --- Optional: RAGAS judge provider ---------------------------------------- #
# JUDGE_PROVIDER selects the swappable evaluation judge: groq | gemini | ollama
# The default is "groq"; set to "ollama" to run the judge fully locally with
# no third-party API call (only place that may hit a free-tier API).
JUDGE_PROVIDER=ollama

# Only needed if JUDGE_PROVIDER=groq
GROQ_API_KEY=

# Only needed if JUDGE_PROVIDER=gemini
GEMINI_API_KEY=

# --- Optional model overrides (defaults live in config.py) ------------------ #
# EMBEDDING_MODEL=qwen3-embedding:0.6b
# GENERATION_MODEL=qwen2.5:7b-instruct
# OLLAMA_HOST=http://localhost:11434

# --- Optional: cloud generation (better answers/metrics; falls back to local) --
# GENERATION_PROVIDER=api routes answering to a hosted OpenAI-compatible model.
# ANY failure (bad key, rate limit, retired model, no network) automatically
# falls back to local Ollama, so the app never goes down because a provider did.
# GENERATION_PROVIDER=api
# GENERATION_API_KEY=your_key_here
#
# Pick ONE provider's base_url + model:
#   Groq:       https://api.groq.com/openai/v1              llama-3.3-70b-versatile
#   Gemini:     https://generativelanguage.googleapis.com/v1beta/openai/   gemini-2.0-flash
#   NVIDIA NIM: https://integrate.api.nvidia.com/v1         meta/llama-3.3-70b-instruct
#   OpenRouter: https://openrouter.ai/api/v1                (see their model list)
# GENERATION_API_BASE_URL=https://api.groq.com/openai/v1
# GENERATION_API_MODEL=llama-3.3-70b-versatile
# GENERATION_API_FALLBACK=true

# --- Multi-provider LLM roles (all free tiers) -------------------------------
# Point question-generation and judging at DIFFERENT providers: if one model
# both writes the questions and grades the answers it favours its own phrasing
# (self-preference bias), which inflates scores.
# Any provider with no key silently uses the local Ollama model instead.
# QUESTIONGEN_PROVIDER=nvidia     # writes golden-set questions (Nemotron 3 Nano)
# JUDGE_PROVIDER=groq             # grades answers (faithfulness/relevancy)
#
# Providers: groq | gemini | nvidia | openrouter | ollama
# GROQ_API_KEY=            # console.groq.com
# GEMINI_API_KEY=          # aistudio.google.com
# NVIDIA_API_KEY=          # build.nvidia.com  (Nemotron / Llama)
# OPENROUTER_API_KEY=      # openrouter.ai
