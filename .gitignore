# Secrets — never commit real keys. Use .env.example as the template.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Per-repository indexed data (rebuildable artifacts, not source)
repositories/*/
!repositories/.gitkeep

# Phase A per-query metrics logs (runtime data, not source)
data/metrics/

# Evaluation outputs: the reports ARE the project's evidence, so they are
# committed. Only the regenerable/noisy parts are ignored.
# (note: .gitignore has no trailing comments — each pattern needs its own line)
# cached judge responses: large, regenerable, no value to a reader
results/**/judge_cache.json
# resume checkpoints written while a run is in progress (regenerable state, and
# the finished ablation.json/csv supersede them)
results/**/rows_partial.jsonl
results/**/partial-*.json
# subprocess log from the in-app evaluation panel
results/**/run.log
# ad-hoc runs launched from the Streamlit UI
results/webrun-*/

# Phase G offline wheelhouse (large; keep on external storage)
wheelhouse/

# HuggingFace / model caches that may land in-tree
.cache/

# Local artifacts: the team plan, and generated bundles for AI chat tools.
# Useful to keep beside the code, but not part of the published project.
_local/

# Generated bundles, wherever they land — these are snapshots of the repo and
# would go stale the moment anything changes.
REPOMIND_FULL.md
REPOMIND_OVERVIEW.md

# OS
.DS_Store
